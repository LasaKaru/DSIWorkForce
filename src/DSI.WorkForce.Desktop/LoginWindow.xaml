<Window x:Class="DSI.WorkForce.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSI WorkForce - Sign in" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FocusManager.FocusedElement="{Binding ElementName=UserNameBox}">
    <StackPanel Margin="28,24">
        <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#0F1D3A"><Run Text="DSI" FontWeight="Bold" /><Run Text=" WorkForce" /></TextBlock>
        <TextBlock Text="Press worksheet digitization" Foreground="#64707D" Margin="0,0,0,18" />
        <TextBlock Text="User name" Foreground="#64707D" />
        <TextBox x:Name="UserNameBox" Padding="6" Margin="0,4,0,12" />
        <TextBlock Text="Password" Foreground="#64707D" />
        <PasswordBox x:Name="PasswordBox" Padding="6" Margin="0,4,0,12" />
        <TextBlock x:Name="ErrorText" Foreground="#C0362C" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
        <Button x:Name="SignInButton" Content="Sign in" IsDefault="True" Padding="8" Background="#1F6F43" Foreground="White"
                BorderThickness="0" Click="OnSignIn" />
        <TextBlock Margin="0,18,0,0" FontSize="11" Foreground="#64707D" TextAlignment="Center">
            <Run Text="© 2026 Helao2 (Pvt) Ltd · support@helao2.com" />
        </TextBlock>
    </StackPanel>
</Window>
