@page "/account/change-password"
@layout Layout.AccountLayout
@attribute [Authorize]

<PageTitle>Change password - DSI WorkForce</PageTitle>
<h1>Change password</h1>
<p class="muted">Signed in as <b>@User?.Identity?.Name</b>. Use at least 8 characters with letters and digits.</p>
@if (!string.IsNullOrEmpty(Error)) { <div class="alert error"><Icon Name="alert" /> @Error</div> }

<form method="post" action="account/change-password" class="form">
    <AntiforgeryToken />
    <label>Current password<input name="currentPassword" type="password" autocomplete="current-password" required /></label>
    <label>New password<input name="newPassword" type="password" autocomplete="new-password" required minlength="8" /></label>
    <label>Repeat new password<input name="confirmPassword" type="password" autocomplete="new-password" required minlength="8" /></label>
    <button class="btn primary block" type="submit">Change password</button>
</form>
<p class="small"><a href="">Back to the dashboard</a></p>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [CascadingParameter] private HttpContext? Http { get; set; }
    private System.Security.Claims.ClaimsPrincipal? User => Http?.User;
}
