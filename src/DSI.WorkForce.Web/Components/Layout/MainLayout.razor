@inherits LayoutComponentBase

<div class="shell">
    <header class="topbar">
        <span class="brand">DSI <b>WorkForce</b></span>
        <nav>
            <NavLink href="" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink href="review">Review</NavLink>
            <NavLink href="reports">Reports</NavLink>
            <NavLink href="upload">Upload scans</NavLink>
            <NavLink href="admin/reports">Report columns</NavLink>
        </nav>
        <span class="user"><AuthorizeView><Authorized>@context.User.Identity?.Name</Authorized><NotAuthorized>dev mode</NotAuthorized></AuthorizeView></span>
    </header>
    <main>@Body</main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
