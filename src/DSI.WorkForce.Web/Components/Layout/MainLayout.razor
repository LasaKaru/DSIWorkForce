@inherits LayoutComponentBase
@using DSI.WorkForce.Core.Licensing
@using DSI.WorkForce.Core.Security
@using DSI.WorkForce.Data
@using DSI.WorkForce.Web.Security
@inject LicenseService Licensing
@inject BrandingService Branding
@inject NavigationManager Nav

<div class="app @(_menuOpen ? "menu-open" : "")">
    <aside class="sidebar">
        <a class="brand" href="" title="DSI WorkForce">
            <img src="img/dsi-tyres-logo.png" alt="DSI Tyres" class="brand-logo" />
            <small>WorkForce · Press worksheet digitization</small>
        </a>

        <AuthorizeView>
            <Authorized>
                <nav class="nav" @onclick="() => _menuOpen = false">
                    <div class="nav-group">Work</div>
                    <NavLink href="" Match="NavLinkMatch.All"><Icon Name="dashboard" /> Dashboard</NavLink>
                    @if (context.User.Can(Permissions.Review)) { <NavLink href="review"><Icon Name="review" /> Review</NavLink> }
                    @if (context.User.Can(Permissions.Reports)) { <NavLink href="reports"><Icon Name="reports" /> Reports</NavLink> }
                    @if (context.User.Can(Permissions.Scan)) { <NavLink href="upload"><Icon Name="upload" /> Upload scans</NavLink> }

                    @if (context.User.Can(Permissions.Users) || context.User.Can(Permissions.MasterData) || context.User.Can(Permissions.ReportDesign) || context.User.Can(Permissions.License) || context.User.Can(Permissions.Admin))
                    {
                        <div class="nav-group">Administration</div>
                        @if (context.User.Can(Permissions.Users)) { <NavLink href="admin/users"><Icon Name="users" /> Users &amp; permissions</NavLink> }
                        @if (context.User.Can(Permissions.MasterData)) { <NavLink href="admin/master-data"><Icon Name="database" /> Master data</NavLink> }
                        @if (context.User.Can(Permissions.ReportDesign)) { <NavLink href="admin/reports"><Icon Name="columns" /> Report columns</NavLink> }
                        @if (context.User.Can(Permissions.License)) { <NavLink href="license"><Icon Name="key" /> License</NavLink> }
                        @if (context.User.Can(Permissions.Admin)) { <NavLink href="admin/settings"><Icon Name="settings" /> Settings</NavLink> }
                    }
                </nav>
            </Authorized>
        </AuthorizeView>

        @if (_branding.ShowVendorBranding)
        {
            <div class="sidebar-foot">
                <span>Powered by</span>
                <img src="img/helao2-logo.png" alt="Helao2" />
            </div>
        }
    </aside>

    <div class="main">
        <header class="topbar">
            <button class="icon-btn menu-btn" @onclick="() => _menuOpen = !_menuOpen" aria-label="Menu"><Icon Name="menu" /></button>
            <div class="spacer"></div>
            @if (_license is { IsValid: true, License: { } l })
            {
                <a class="license-chip @(_license.DaysLeft is <= 14 ? "warn" : "")" href="license" title="@_license.Message">
                    <Icon Name="shield" Size="14" /> @l.Type@(_license.DaysLeft is { } d ? $" · {d} day(s) left" : "")
                </a>
            }
            <AuthorizeView>
                <Authorized>
                    <div class="user-menu">
                        <span class="avatar">@Initials(context.User)</span>
                        <span class="user-name">@context.User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value<small>@context.User.Identity?.Name</small></span>
                        <a class="icon-btn" href="account/change-password" title="Change password"><Icon Name="key" /></a>
                        <form method="post" action="account/logout" class="inline">
                            <AntiforgeryToken />
                            <button class="icon-btn" type="submit" title="Sign out"><Icon Name="logout" /></button>
                        </form>
                    </div>
                </Authorized>
            </AuthorizeView>
        </header>

        @if (_license is { IsValid: true, DaysLeft: <= 14 } soon)
        {
            <div class="banner warn">
                <Icon Name="alert" /> The license expires in <b>@soon.DaysLeft day(s)</b>. Contact
                <a href="mailto:@LicenseService.SupportEmail">@LicenseService.SupportEmail</a> to renew.
            </div>
        }

        <main class="content">
            @if (_license is { IsValid: false } && !OnLicensePage)
            {
                <div class="empty-state">
                    <Icon Name="lock" Size="40" />
                    <h2>Product not activated</h2>
                    <p>@_license.Message</p>
                    <a class="btn primary" href="license">Go to activation</a>
                </div>
            }
            else
            {
                @Body
            }
        </main>

        <AppFooter>
            @if (_license?.License is { } lic) { <span>Licensed to <b>@lic.LicensedTo</b></span> }
        </AppFooter>
    </div>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private LicenseCheck? _license;
    private DSI.WorkForce.Core.Contracts.BrandingSettings _branding = new();
    private bool _menuOpen;

    private bool OnLicensePage => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("license", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        _license = await Licensing.GetAsync();
        _branding = await Branding.GetAsync();
    }

    private static string Initials(System.Security.Claims.ClaimsPrincipal u)
    {
        var name = u.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? u.Identity?.Name ?? "?";
        return string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }
}
