{
  "Database": {
    "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=DSIWorkForce;Integrated Security=true;TrustServerCertificate=true;Connect Timeout=60;Application Name=DSI.WorkForce.Web",
    "CommandTimeoutSeconds": 60,
    "AutoMigrate": false,
    "SeedSampleData": false
  },
  "Upload": {
    "HotFolders": {
      "PC-011-A": "\\\\FILESERVER\\Scans\\PC-011-A"
    },
    "MaxFileBytes": 104857600
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/web-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
