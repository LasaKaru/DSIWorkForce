{
  "Database": {
    "ConnectionString": "Server=YOUR_SQL_SERVER;Database=DSIWorkForce;Integrated Security=true;TrustServerCertificate=true;Application Name=DSI.WorkForce.Web",
    "CommandTimeoutSeconds": 60
  },
  "Auth": {
    "Mode": "Windows",
    "ReviewerRoles": [],
    "AdminRoles": []
  },
  "Upload": {
    "HotFolders": {
      "PC-011-A": "\\\\FILESERVER\\Scans\\PC-011-A"
    },
    "MaxFileBytes": 104857600
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "Microsoft.AspNetCore": "Warning", "System": "Warning" }
    },
    "WriteTo": [
      { "Name": "File", "Args": { "path": "logs/web-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 } }
    ]
  },
  "AllowedHosts": "*"
}
