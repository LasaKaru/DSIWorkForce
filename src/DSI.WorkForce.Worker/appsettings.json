{
  "Database": {
    "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=DSIWorkForce;Integrated Security=true;TrustServerCertificate=true;Connect Timeout=60;Application Name=DSI.WorkForce.Worker",
    "CommandTimeoutSeconds": 60,
    "AutoMigrate": false,
    "SeedSampleData": false
  },
  "Worker": {
    "HotFolders": [
      {
        "Path": "\\\\FILESERVER\\Scans\\PC-011-A",
        "TemplateCode": "PC-011-A",
        "Station": "Press Section Scanner"
      }
    ],
    "StagingRoot": "D:\\DSIWorkForce\\staging",
    "DuplicatesFolder": "D:\\DSIWorkForce\\duplicates",
    "ImageRoot": "D:\\DSIWorkForce\\images",
    "PollIntervalSeconds": 5,
    "FileStableSeconds": 2,
    "MaxDegreeOfParallelism": 0,
    "BatchSize": 16,
    "LeaseMinutes": 10,
    "MaxAttempts": 5,
    "MasterDataRefreshMinutes": 5,
    "MaxMemoryMb": 0
  },
  "Extraction": {
    "Recognizer": "Local",
    "EscalateTo": "None",
    "EscalateBelowConfidence": 0.85,
    "Local": {
      "Model": "PPOCRv5",
      "Variants": 3,
      "CpuThreads": 1
    },
    "AlignedImageJpegQuality": 75,
    "BlankInkThreshold": 0.006,
    "Azure": {
      "Endpoint": "",
      "ApiKey": "",
      "ModelId": "prebuilt-read"
    },
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "qwen2.5vl:7b",
      "AssumedConfidence": 0.92,
      "TimeoutSeconds": 120
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/worker-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  }
}
